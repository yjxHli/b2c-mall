<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjx.b2c.product.dao.mapper.SkuLogMapper">

    <insert id="save" parameterType="com.yjx.b2c.product.dao.po.SkuLogPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_sku_log (sku_id, shop_id, operator_id, action, detail)
        VALUES (#{skuId}, #{shopId}, #{operatorId}, #{action}, #{detail})
    </insert>

</mapper>
