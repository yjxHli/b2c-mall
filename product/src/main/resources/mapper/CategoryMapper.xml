<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjx.b2c.product.dao.mapper.CategoryMapper">

    <select id="findById" resultType="com.yjx.b2c.product.dao.po.CategoryPO">
        SELECT id,
               parent_id     AS parentId,
               category_name AS categoryName,
               level,
               status
        FROM tb_category
        WHERE id = #{id}
    </select>

    <select id="countChildren" resultType="int">
        SELECT count(1)
        FROM tb_category
        WHERE parent_id = #{parentId}
          AND status = 1
    </select>

</mapper>
